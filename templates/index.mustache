<div class="header d-flex align-items-center justify-content-between mb-3">
    <div class="mybalance d-flex align-items-center">
        <div class="dollar-sign"><i class="fa fa-dollar-sign"></i></div>
        <div class="coins">
            <span class="label">{{#str}}mybalance, local_ultimate{{/str}}</span>
            {{coins}} <span>{{#str}}coins, local_ultimate{{/str}}</span>
        </div>
    </div>

    <a href="{{config.wwwroot}}/local/ultimate_market/mypurchases.php?id={{courseid}}" class="btn btn-info"><i class="fa fa-shopping-bag"></i> {{#str}}mypurchases, local_ultimate_market{{/str}}</a>
</div>

<div class="my-2">
    <div class="row">
        {{#products}}
            <div class="col-md-4">
                <div class="card shadow-none border my-2">
                    <div id="images-{{id}}" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            {{#images}}
                                <div class="carousel-item {{#active}}active{{/active}}">
                                    <img class="d-block w-100" src="{{fileurl}}">
                                </div>
                            {{/images}}
                            {{#coursename}}
                                <span class="ribbon"><i class="fa fa-star"></i> {{#str}}exclusivecourseproduct, local_ultimate_market{{/str}}</span>
                            {{/coursename}}
                        </div>
                        <a class="carousel-control-prev" href="#images-{{id}}" role="button" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="sr-only">{{#str}}previous, local_ultimate_market{{/str}}</span>
                        </a>
                        <a class="carousel-control-next" href="#images-{{id}}" role="button" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="sr-only">{{#str}}next, local_ultimate_market{{/str}}</span>
                        </a>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">{{name}}</h5>
                        <p class="card-text">{{description}}</p>
                        {{#instock}}
                            <span class="badge badge-secondary">{{#str}}stock, local_ultimate_market{{/str}}:
                                {{#stock}}
                                    {{.}}
                                {{/stock}}
                                {{^stock}}
                                    {{#str}}unlimited, local_ultimate_market{{/str}}
                                {{/stock}}
                            </span>
                        {{/instock}}
                        {{^instock}}
                            <span class="badge badge-warning">{{#str}}outofstock, local_ultimate_market{{/str}}</span>
                        {{/instock}}
                    </div>
                    <div class="card-footer d-flex">
                        <div class="info">
                            <div class="icon">
                                <i class="fa fa-dollar-sign"></i>
                            </div>
                            <div class="price">{{price}}</div>
                        </div>
                        {{#instock}}
                            <div class="buttons ml-auto">
                                <form action="{{config.wwwroot}}/local/ultimate_market/buy.php" method="POST" class="form-singlebutton">
                                    <input type="hidden" name="id" value="{{id}}">
                                    <input type="hidden" name="courseid" value="{{courseid}}">
                                    <button class="btn-buy btn btn-sm btn-primary"><i class="fa fa-shopping-cart"></i> {{#str}}buy, local_ultimate_market{{/str}}</button>
                                </form>
                            </div>
                        {{/instock}}
                    </div>
                </div>
            </div>
        {{/products}}
    </div>
</div>

{{#js}}
    require(['jquery', 'local_ultimate_market/sweetalert'], function($, Swal) {
        $("body").on("click", ".btn-buy", function(event) {
            event.preventDefault();

            var button = $(this);

            Swal.fire({
                title: '{{#str}}buy_confirm_title, local_ultimate_market{{/str}}',
                text: '{{#str}}buy_confirm_msg, local_ultimate_market{{/str}}',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '{{#str}}confirm_yes, local_ultimate_market{{/str}}',
                cancelButtonText: '{{#str}}confirm_no, local_ultimate_market{{/str}}'
            }).then(function(result) {
                if (result.value) {
                    const form = button.closest("form");

                    form.append('<input type="hidden" name="sesskey" value="{{config.sesskey}}">');

                    form.submit();
                 }
            });
        });
    });
{{/js}}