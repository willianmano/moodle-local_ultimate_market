<div class="mb-4">
    <a href="{{config.wwwroot}}/local/ultimate_market/admin/products.php?action=create"
       class="btn btn-primary">
        {{#str}}product_create_button, local_ultimate_market{{/str}}
    </a>
</div>

<div class="my-2">
    <div class="row">
        {{#products}}
            <div class="col-md-4">
                <div class="card shadow-none border my-2">
                    <div id="images-{{id}}" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            {{#images}}
                                <div class="carousel-item {{#active}}active{{/active}}">
                                    <img class="d-block w-100" src="{{fileurl}}">
                                </div>
                            {{/images}}
                        </div>
                        <a class="carousel-control-prev" href="#images-{{id}}" role="button" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="sr-only">{{#str}}previous, local_ultimate_market{{/str}}</span>
                        </a>
                        <a class="carousel-control-next" href="#images-{{id}}" role="button" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="sr-only">{{#str}}next, local_ultimate_market{{/str}}</span>
                        </a>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">{{name}}</h5>
                        <p class="card-text">{{description}}</p>
                        {{#instock}}
                            <span class="badge badge-secondary">{{#str}}stock, local_ultimate_market{{/str}}:
                                {{#stock}}
                                    {{.}}
                                {{/stock}}
                                {{^stock}}
                                    {{#str}}unlimited, local_ultimate_market{{/str}}
                                {{/stock}}
                            </span>
                        {{/instock}}
                        {{^instock}}
                            <span class="badge badge-warning">{{#str}}outofstock, local_ultimate_market{{/str}}</span>
                        {{/instock}}
                        {{#coursename}}
                            <div class="d-block">
                                <span class="badge badge-primary">{{#str}}course, local_ultimate_market{{/str}}: {{coursename}}</span>
                            </div>
                        {{/coursename}}
                        <div class="d-block mt-1">
                            {{#enabled}}
                                <span class="badge badge-success">{{#str}}enabled, local_ultimate_market{{/str}}</span>
                            {{/enabled}}
                            {{^enabled}}
                                <span class="badge badge-secondary">{{#str}}disabled, local_ultimate_market{{/str}}</span>
                            {{/enabled}}
                        </div>
                    </div>
                    <div class="card-footer">
                        <a href="{{config.wwwroot}}/local/ultimate_market/admin/products.php?action=update&id={{id}}" class="btn btn-sm btn-info"><i class="fa fa-pencil"></i></a>
                        <form action="{{config.wwwroot}}/local/ultimate_market/admin/products.php?action=toggleenabled" method="POST" class="form-singlebutton d-inline">
                            <input type="hidden" name="id" value="{{id}}">
                            {{#enabled}}
                                <button class="btn-toggleenabled btn btn-sm btn-secondary" data-enabled="1"><i class="fa fa-eye-slash"></i> {{#str}}disable, local_ultimate_market{{/str}}</button>
                            {{/enabled}}
                            {{^enabled}}
                                <button class="btn-toggleenabled btn btn-sm btn-success" data-enabled="0"><i class="fa fa-eye"></i> {{#str}}enable, local_ultimate_market{{/str}}</button>
                            {{/enabled}}
                        </form>
                        <form action="{{config.wwwroot}}/local/ultimate_market/admin/products.php?action=delete" method="POST" class="form-singlebutton d-inline">
                            <input type="hidden" name="id" value="{{id}}">
                            <button class="btn-delete btn btn-sm btn-danger"><i class="fa fa-trash-o"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        {{/products}}
    </div>
</div>

{{#js}}
    require(['jquery', 'local_ultimate_market/sweetalert'], function($, Swal) {
        $("body").on("click", ".btn-delete", function(event) {
            event.preventDefault();

            var button = $(this);

            Swal.fire({
                title: '{{#str}}deleteitem_confirm_title, local_ultimate_market{{/str}}',
                text: '{{#str}}deleteitem_confirm_msg, local_ultimate_market{{/str}}',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '{{#str}}confirm_yes, local_ultimate_market{{/str}}',
                cancelButtonText: '{{#str}}confirm_no, local_ultimate_market{{/str}}'
            }).then(function(result) {
                if (result.value) {
                    const form = button.closest("form");

                    form.append('<input type="hidden" name="sesskey" value="{{config.sesskey}}">');

                    form.submit();
                }
            });
        });

        $("body").on("click", ".btn-toggleenabled", function(event) {
            event.preventDefault();

            var button = $(this);

            var enabling = button.data("enabled") == 0;

            Swal.fire({
                title: '{{#str}}toggleenabled_confirm_title, local_ultimate_market{{/str}}',
                text: enabling ?
                    '{{#str}}toggleenabled_enable_confirm_msg, local_ultimate_market{{/str}}' :
                    '{{#str}}toggleenabled_disable_confirm_msg, local_ultimate_market{{/str}}',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: '{{#str}}confirm_yes, local_ultimate_market{{/str}}',
                cancelButtonText: '{{#str}}confirm_no, local_ultimate_market{{/str}}'
            }).then(function(result) {
                if (result.value) {
                    const form = button.closest("form");

                    form.append('<input type="hidden" name="sesskey" value="{{config.sesskey}}">');

                    form.submit();
                }
            });
        });
    });
{{/js}}